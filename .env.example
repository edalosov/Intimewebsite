# Postgres connection string (e.g. Vercel Postgres, Neon, Supabase).
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Alchemy API key — used server-side to read NFT ownership/metadata.
# Create a free app at https://dashboard.alchemy.com (enable Sepolia + Ethereum Mainnet).
ALCHEMY_API_KEY=""

# Same Alchemy key, exposed to the client if you later need client-side reads.
NEXT_PUBLIC_ALCHEMY_API_KEY=""

# WalletConnect Cloud project ID, powers the RainbowKit connect modal.
# Create one for free at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# Password for the /admin panel (contract address + question editor).
ADMIN_PASSWORD=""

# Random 32+ character secret used to encrypt the admin session cookie.
# Generate with: openssl rand -base64 32
SESSION_SECRET=""
